{
  "name": "youtube-video-manager",
  "version": "0.1.0",
  "description": "Desktop app to queue and schedule YouTube uploads for a single channel.",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f",
    "rebuild:sqlite": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f || true"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^35.3.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "vite": "^6.3.5"
  },
  "build": {
    "appId": "com.jonathanbossenger.youtube-video-manager",
    "productName": "YouTube Video Manager",
    "copyright": "Copyright © 2025 Jonathan Bossenger",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    },
    "afterPack": "scripts/afterPack.js"
  }
}
